# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version.local

# Virtual environments
.venv/
venv/
env/

# Testing and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build outputs
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Raw and private data
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Reports may contain source data
reports/*
!reports/.gitkeep

# Databases and local runtime files
*.db
*.sqlite
*.sqlite3
*.log

# Temporary files
*.tmp
*.temp
*.bak
~$*
